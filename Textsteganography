import java.io.*;
import java.nio.file.*;
import java.util.*;

// ─────────────────────────────────────────────
//  ABSTRACT BASE CLASS  (Abstraction)
// ─────────────────────────────────────────────
abstract class SteganographyMethod {

    // Template method pattern
    public final String encode(String coverText, String secretMessage) {
        validate(coverText, secretMessage);
        String bits = textToBinary(secretMessage);
        return embedBits(coverText, bits);
    }

    public final String decode(String encodedText) {
        String bits = extractBits(encodedText);
        return binaryToText(bits);
    }

    // Abstract methods — subclasses must implement
    protected abstract String embedBits(String coverText, String bits);
    protected abstract String extractBits(String encodedText);
    public    abstract String getMethodName();
    public    abstract int    getCapacity(String coverText);

    // Shared utilities (Encapsulation — private helpers)
    protected String textToBinary(String text) {
        StringBuilder sb = new StringBuilder();
        for (char c : text.toCharArray()) {
            sb.append(String.format("%8s", Integer.toBinaryString(c))
                           .replace(' ', '0'));
        }
        sb.append("00000000"); // null-byte delimiter
        return sb.toString();
    }

    protected String binaryToText(String bits) {
        StringBuilder result = new StringBuilder();
        for (int i = 0; i + 8 <= bits.length(); i += 8) {
            String byteStr = bits.substring(i, i + 8);
            int code = Integer.parseInt(byteStr, 2);
            if (code == 0) break;
            result.append((char) code);
        }
        return result.toString();
    }

    protected void validate(String cover, String secret) {
        if (cover == null || cover.isEmpty())
            throw new IllegalArgumentException("Cover text cannot be empty.");
        if (secret == null || secret.isEmpty())
            throw new IllegalArgumentException("Secret message cannot be empty.");
        int capacity = getCapacity(cover);
        if (secret.length() > capacity)
            throw new IllegalArgumentException(
                "Cover too short! Capacity: " + capacity +
                " chars, needed: " + secret.length());
    }
}


// ─────────────────────────────────────────────
//  CONCRETE CLASS 1 — Zero-Width Characters
//  (Inheritance + Polymorphism)
// ─────────────────────────────────────────────
class ZeroWidthMethod extends SteganographyMethod {

    private static final char BIT_ZERO = '\u200B'; // Zero-Width Space
    private static final char BIT_ONE  = '\u200C'; // Zero-Width Non-Joiner

    @Override
    public String getMethodName() { return "Zero-Width Characters"; }

    @Override
    public int getCapacity(String coverText) {
        long spaces = coverText.chars().filter(c -> c == ' ').count();
        return (int)(spaces / 8);
    }

    @Override
    protected String embedBits(String coverText, String bits) {
        String[] words = coverText.split(" ", -1);
        StringBuilder result = new StringBuilder(words[0]);
        int bitIdx = 0;

        for (int i = 1; i < words.length; i++) {
            if (bitIdx < bits.length()) {
                result.append(bits.charAt(bitIdx) == '1' ? BIT_ONE : BIT_ZERO);
                bitIdx++;
            }
            result.append(' ').append(words[i]);
        }
        return result.toString();
    }

    @Override
    protected String extractBits(String encodedText) {
        StringBuilder bits = new StringBuilder();
        for (char c : encodedText.toCharArray()) {
            if (c == BIT_ZERO) bits.append('0');
            else if (c == BIT_ONE) bits.append('1');
        }
        return bits.toString();
    }
}


// ─────────────────────────────────────────────
//  CONCRETE CLASS 2 — Whitespace Encoding
// ─────────────────────────────────────────────
class WhitespaceMethod extends SteganographyMethod {

    @Override
    public String getMethodName() { return "Whitespace Encoding"; }

    @Override
    public int getCapacity(String coverText) {
        String[] lines = coverText.split("\n", -1);
        return lines.length;
    }

    @Override
    protected String embedBits(String coverText, String bits) {
        String[] lines = coverText.split("\n", -1);
        StringBuilder result = new StringBuilder();

        for (int i = 0; i < lines.length; i++) {
            // Strip old trailing whitespace
            String line = lines[i].replaceAll("[ \t]+$", "");
            result.append(line);

            if (i * 8 < bits.length()) {
                String chunk = bits.substring(
                    i * 8, Math.min(i * 8 + 8, bits.length()))
                    + "0".repeat(8); // pad to 8 bits
                chunk = chunk.substring(0, 8);

                for (char bit : chunk.toCharArray()) {
                    result.append(bit == '1' ? '\t' : ' ');
                }
            }
            if (i < lines.length - 1) result.append('\n');
        }
        return result.toString();
    }

    @Override
    protected String extractBits(String encodedText) {
        StringBuilder bits = new StringBuilder();
        for (String line : encodedText.split("\n", -1)) {
            // Extract exactly 8 trailing whitespace chars
            java.util.regex.Matcher m =
                java.util.regex.Pattern.compile("[ \t]{8}$").matcher(line);
            if (m.find()) {
                for (char c : m.group().toCharArray()) {
                    bits.append(c == '\t' ? '1' : '0');
                }
            }
        }
        return bits.toString();
    }
}


// ─────────────────────────────────────────────
//  CONCRETE CLASS 3 — Unicode Variation Selectors
// ─────────────────────────────────────────────
class UnicodeVariationMethod extends SteganographyMethod {

    private static final char VS_ZERO = '\uFE00'; // Variation Selector-1
    private static final char VS_ONE  = '\uFE01'; // Variation Selector-2

    @Override
    public String getMethodName() { return "Unicode Variation Selectors"; }

    @Override
    public int getCapacity(String coverText) {
        long nonSpaces = coverText.chars().filter(c -> !Character.isWhitespace(c)).count();
        return (int)(nonSpaces / 8);
    }

    @Override
    protected String embedBits(String coverText, String bits) {
        StringBuilder result = new StringBuilder();
        int bitIdx = 0;
        for (char c : coverText.toCharArray()) {
            result.append(c);
            if (!Character.isWhitespace(c) && bitIdx < bits.length()) {
                result.append(bits.charAt(bitIdx) == '1' ? VS_ONE : VS_ZERO);
                bitIdx++;
            }
        }
        return result.toString();
    }

    @Override
    protected String extractBits(String encodedText) {
        StringBuilder bits = new StringBuilder();
        for (char c : encodedText.toCharArray()) {
            if (c == VS_ZERO) bits.append('0');
            else if (c == VS_ONE) bits.append('1');
        }
        return bits.toString();
    }
}


// ─────────────────────────────────────────────
//  INTERFACE — File Operations
//  (Abstraction via Interface)
// ─────────────────────────────────────────────
interface FileOperations {
    String readFile(String path) throws IOException;
    void   writeFile(String path, String content) throws IOException;
}


// ─────────────────────────────────────────────
//  STEGANOGRAPHY ENGINE  (Encapsulation)
//  Orchestrates encoding/decoding + file I/O
// ─────────────────────────────────────────────
class SteganographyEngine implements FileOperations {

    // Encapsulated fields
    private final Map<String, SteganographyMethod> methods = new LinkedHashMap<>();
    private SteganographyMethod currentMethod;

    public SteganographyEngine() {
        // Register all methods
        methods.put("1", new ZeroWidthMethod());
        methods.put("2", new WhitespaceMethod());
        methods.put("3", new UnicodeVariationMethod());
        currentMethod = methods.get("1"); // default
    }

    public void setMethod(String key) {
        if (!methods.containsKey(key))
            throw new IllegalArgumentException("Invalid method key: " + key);
        currentMethod = methods.get(key);
    }

    public Map<String, SteganographyMethod> getMethods() {
        return Collections.unmodifiableMap(methods);
    }

    public String encodeAndSave(String coverText, String secret, String outputPath)
            throws IOException {
        String encoded = currentMethod.encode(coverText, secret);
        writeFile(outputPath, encoded);
        return encoded;
    }

    public String decodeFromFile(String path) throws IOException {
        String content = readFile(path);
        return decodeAuto(content);
    }

    public String decodeAuto(String encodedText) {
        // Polymorphism — try each method automatically
        for (SteganographyMethod method : methods.values()) {
            try {
                String result = method.decode(encodedText);
                if (result != null && !result.isEmpty()) {
                    System.out.println("   [Auto-detected method: " + method.getMethodName() + "]");
                    return result;
                }
            } catch (Exception ignored) {}
        }
        return "(no hidden message found)";
    }

    @Override
    public String readFile(String path) throws IOException {
        return new String(Files.readAllBytes(Paths.get(path)));
    }

    @Override
    public void writeFile(String path, String content) throws IOException {
        Files.write(Paths.get(path), content.getBytes());
    }

    public int getCapacity(String coverText) {
        return currentMethod.getCapacity(coverText);
    }

    public String getCurrentMethodName() {
        return currentMethod.getMethodName();
    }
}


// ─────────────────────────────────────────────
//  RESULT — Immutable value object
// ─────────────────────────────────────────────
class StegResult {
    private final boolean success;
    private final String  message;
    private final String  detail;

    public StegResult(boolean success, String message, String detail) {
        this.success = success;
        this.message = message;
        this.detail  = detail;
    }

    public boolean isSuccess() { return success; }
    public String  getMessage() { return message; }
    public String  getDetail()  { return detail; }

    @Override
    public String toString() {
        return (success ? "✓" : "✗") + " " + message +
               (detail.isEmpty() ? "" : "\n   → " + detail);
    }
}


// ─────────────────────────────────────────────
//  MAIN CLASS — CLI Interface + Test Suite
// ─────────────────────────────────────────────
public class TextSteganography {

    static final String RESET  = "\u001B[0m";
    static final String BOLD   = "\u001B[1m";
    static final String GREEN  = "\u001B[32m";
    static final String RED    = "\u001B[31m";
    static final String CYAN   = "\u001B[36m";
    static final String YELLOW = "\u001B[33m";
    static final String DIM    = "\u001B[2m";

    public static void main(String[] args) {
        printBanner();
        SteganographyEngine engine = new SteganographyEngine();
        Scanner scanner = new Scanner(System.in);

        boolean running = true;
        while (running) {
            printMenu();
            System.out.print(BOLD + "  Choice > " + RESET);
            String choice = scanner.nextLine().trim();

            switch (choice) {
                case "1" -> encodeFlow(engine, scanner);
                case "2" -> decodeFlow(engine, scanner);
                case "3" -> runTests(engine);
                case "4" -> changeMethod(engine, scanner);
                case "5" -> { System.out.println(DIM + "  Goodbye.\n" + RESET); running = false; }
                default  -> System.out.println(RED + "  Invalid choice.\n" + RESET);
            }
        }
        scanner.close();
    }

    // ── ENCODE FLOW ──────────────────────────
    static void encodeFlow(SteganographyEngine engine, Scanner scanner) {
        System.out.println("\n" + CYAN + BOLD + "  ── ENCODE ─────────────────────────" + RESET);
        System.out.println(DIM + "  Method: " + engine.getCurrentMethodName() + RESET);

        System.out.print("  Cover text (or path to .txt): ");
        String coverInput = scanner.nextLine().trim();
        String coverText = loadTextOrString(engine, coverInput);

        System.out.println("  Capacity: " + engine.getCapacity(coverText) +
                           " characters can be hidden.");

        System.out.print("  Secret message: ");
        String secret = scanner.nextLine().trim();

        System.out.print("  Output file path [encoded.txt]: ");
        String outPath = scanner.nextLine().trim();
        if (outPath.isEmpty()) outPath = "encoded.txt";

        try {
            String encoded = engine.encodeAndSave(coverText, secret, outPath);
            System.out.println(GREEN + "\n  ✓ Encoded successfully → " + outPath + RESET);
            System.out.println(DIM + "  Preview (first 80 chars): " +
                               visible(encoded.substring(0, Math.min(80, encoded.length()))) + RESET);
        } catch (Exception e) {
            System.out.println(RED + "  ✗ Error: " + e.getMessage() + RESET);
        }
        System.out.println();
    }

    // ── DECODE FLOW ──────────────────────────
    static void decodeFlow(SteganographyEngine engine, Scanner scanner) {
        System.out.println("\n" + CYAN + BOLD + "  ── DECODE ─────────────────────────" + RESET);
        System.out.print("  Encoded text or file path: ");
        String input = scanner.nextLine().trim();
        String text = loadTextOrString(engine, input);

        System.out.print("  Use auto-detect? (y/n) [y]: ");
        String choice = scanner.nextLine().trim();

        String result;
        if (choice.equalsIgnoreCase("n")) {
            changeMethod(engine, scanner);
            result = engine.getCurrentMethodName();
            try {
                result = engine.getMethods().values().stream()
                    .filter(m -> m.getMethodName().equals(engine.getCurrentMethodName()))
                    .findFirst()
                    .map(m -> m.decode(text))
                    .orElse("(error)");
            } catch (Exception e) {
                System.out.println(RED + "  ✗ " + e.getMessage() + RESET);
                return;
            }
        } else {
            result = engine.decodeAuto(text);
        }

        System.out.println(GREEN + "\n  ✓ Hidden message: " + BOLD + result + RESET + "\n");
    }

    // ── TEST SUITE ───────────────────────────
    static void runTests(SteganographyEngine engine) {
        System.out.println("\n" + CYAN + BOLD + "  ── TEST SUITE ──────────────────────" + RESET);

        record TestCase(String label, String method, String cover, String secret) {}

        List<TestCase> tests = List.of(
            new TestCase("ZWC — short message",
                "1",
                "The quick brown fox jumps over the lazy dog near the river bank at dusk.",
                "Hi!"),
            new TestCase("ZWC — longer secret",
                "1",
                "Artificial intelligence is transforming the modern world in ways never seen before now.",
                "Java OOP"),
            new TestCase("Whitespace — multi-line",
                "2",
                "Meeting started at nine.\nProject is on schedule.\nBudget approved today.\nDeadline is confirmed.\nAll tasks are assigned.\nReview on Friday.\nDocuments are ready.\nTeam is aligned now.",
                "SECRET"),
            new TestCase("Unicode VS — paragraph",
                "3",
                "Steganography is the practice of hiding secret information within ordinary non-secret data.",
                "Hidden"),
            new TestCase("ZWC — special chars",
                "1",
                "Pack my box with five dozen liquor jugs to fill the shelf right away.",
                "Pass@123")
        );

        int pass = 0, fail = 0;
        for (TestCase tc : tests) {
            engine.setMethod(tc.method());
            StegResult r = runSingleTest(engine, tc.cover(), tc.secret(), tc.label());
            System.out.println("  " + r);
            if (r.isSuccess()) pass++; else fail++;
        }

        System.out.println("\n" + BOLD + "  Results: " +
            GREEN + pass + " passed" + RESET + BOLD + " / " +
            (fail > 0 ? RED : DIM) + fail + " failed" + RESET + "\n");
    }

    static StegResult runSingleTest(SteganographyEngine engine,
                                    String cover, String secret, String label) {
        try {
            SteganographyMethod m = engine.getMethods().get(
                engine.getMethods().entrySet().stream()
                    .filter(e -> e.getValue().getMethodName()
                        .equals(engine.getCurrentMethodName()))
                    .map(Map.Entry::getKey).findFirst().orElse("1"));

            String encoded = m.encode(cover, secret);
            String decoded = m.decode(encoded);

            boolean ok = secret.equals(decoded);
            return new StegResult(ok, label,
                ok ? "decoded: \"" + decoded + "\""
                   : "expected \"" + secret + "\" got \"" + decoded + "\"");
        } catch (Exception e) {
            return new StegResult(false, label, "Exception: " + e.getMessage());
        }
    }

    // ── CHANGE METHOD ────────────────────────
    static void changeMethod(SteganographyEngine engine, Scanner scanner) {
        System.out.println("\n" + CYAN + "  Select method:" + RESET);
        engine.getMethods().forEach((k, v) ->
            System.out.println("    " + k + ") " + v.getMethodName()));
        System.out.print("  Choice [1]: ");
        String c = scanner.nextLine().trim();
        if (c.isEmpty()) c = "1";
        try {
            engine.setMethod(c);
            System.out.println(GREEN + "  Method set to: " +
                engine.getCurrentMethodName() + RESET + "\n");
        } catch (Exception e) {
            System.out.println(RED + "  Invalid." + RESET);
        }
    }

    // ── HELPERS ──────────────────────────────
    static String loadTextOrString(SteganographyEngine engine, String input) {
        if (input.endsWith(".txt") && new File(input).exists()) {
            try {
                String content = engine.readFile(input);
                System.out.println(DIM + "  Loaded from file: " + input + RESET);
                return content;
            } catch (IOException e) {
                System.out.println(RED + "  Could not read file: " + e.getMessage() + RESET);
            }
        }
        return input;
    }

    // Make invisible chars visible for display
    static String visible(String s) {
        return s.replace("\u200B", "[ZWS]")
                .replace("\u200C", "[ZWNJ]")
                .replace("\uFE00", "[VS0]")
                .replace("\uFE01", "[VS1]")
                .replace("\t", "[TAB]");
    }

    static void printBanner() {
        System.out.println(CYAN + BOLD + """
        
          ╔══════════════════════════════════════════╗
          ║     TEXT STEGANOGRAPHY SYSTEM            ║
          ║     Java OOP Implementation              ║
          ╚══════════════════════════════════════════╝
        """ + RESET);
    }

    static void printMenu() {
        System.out.println(BOLD + "  ─── MAIN MENU ───────────────────────" + RESET);
        System.out.println("    1) Encode — hide a secret message");
        System.out.println("    2) Decode — reveal hidden message");
        System.out.println("    3) Run test suite");
        System.out.println("    4) Change encoding method");
        System.out.println("    5) Exit");
        System.out.println(DIM + "  ──────────────────────